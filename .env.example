# =========================================================
# CDT2 — environment configuration
# Copy this file to .env and fill in real values.
# Never commit a real .env file.
# =========================================================

# --- Database ---
# Default: local SQLite file, zero setup, used automatically if unset.
# For production/Postgres: postgresql+psycopg2://user:password@localhost:5432/cyber_twin
DATABASE_URL=sqlite:///./cyber_twin.db

# --- Neo4j (optional; NetworkX is used by default so the app runs without it) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM Provider (AI Security Advisor — Phase 8, not required to boot) ---
# One of: openai | anthropic | gemini | ollama
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings (RAG — Phase 7, not required to boot) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Threat Intelligence (Phase 6, not required to boot) ---
MITRE_DATA_PATH=./data/threat_intelligence/mitre_attack.json
NVD_API_KEY=

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=true
